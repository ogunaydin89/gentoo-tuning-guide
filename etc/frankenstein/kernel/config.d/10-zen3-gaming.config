# ==============================================================================
# AMD Zen 3 Ultra-Tuned Gaming Kernel Configuration
# ==============================================================================

# Target the build machine's CPU natively (-march=native)
# Mainline removed CONFIG_MZEN3 & co. (absent in 6.18); they are silently ignored.
CONFIG_X86_NATIVE_CPU=y

# 1000Hz Ultra-Low Latency Timer Tick Rate (1ms granularity)
CONFIG_HZ_1000=y
# CONFIG_HZ_300 is not set
CONFIG_HZ=1000

# Full Low-Latency Desktop Preemption
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT_LAZY is not set

# Realtime Priority Boosting & Scheduler Optimizations
# RCU_BOOST is only offered with RCU_EXPERT=y
CONFIG_RCU_EXPERT=y
CONFIG_RCU_BOOST=y
CONFIG_RCU_BOOST_DELAY=0
CONFIG_SCHED_SMT=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_HRTICK=y

# High-Performance Memory & HugePages
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
CONFIG_DEFAULT_MMAP_MIN_ADDR=65536

# Custom CPUvGPU Kernel Release Naming
CONFIG_LOCALVERSION="-5700v6650"
