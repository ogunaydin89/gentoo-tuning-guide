# ==============================================================================
# Desktop Peripherals & Hardware Telemetry Extensions
# Custom minimal kernel additions for daily desktop usability
# ==============================================================================

# --- External USB Storage & Filesystems ---
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m

# --- Motherboard Super I/O Sensor (MSI MPG B550 GAMING PLUS) ---
CONFIG_HWMON=y
CONFIG_SENSORS_NCT6683=m
CONFIG_SENSORS_K10TEMP=m

# --- USB Audio, Microphones & Webcams ---
CONFIG_SND_USB_AUDIO=m
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m

# --- Input Devices, Game Controllers & Steam Input ---
CONFIG_INPUT_UINPUT=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_SONY=m

# --- VPN & Container Networking ---
CONFIG_TUN=m
CONFIG_WIREGUARD=m
CONFIG_BRIDGE=m
CONFIG_VETH=m
CONFIG_OVERLAY_FS=m

# --- Bluetooth Subsystem & USB Dongles ---
CONFIG_BT=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m
