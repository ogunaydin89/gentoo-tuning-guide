# Latency and scheduling tuning on top of Gentoo's default kernel config.
# Workstation PC: Ryzen 7 5700X (Zen 3).

# Build for the machine's own CPU (-march=native).
# Mainline removed CONFIG_MZEN3 and friends (absent in 6.18); they are silently ignored.
CONFIG_X86_NATIVE_CPU=y

# 1000 Hz timer tick
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# Full preemption
CONFIG_PREEMPT=y

# RCU priority boosting (RCU_BOOST is only offered with RCU_EXPERT=y)
CONFIG_RCU_EXPERT=y
CONFIG_RCU_BOOST=y
CONFIG_RCU_BOOST_DELAY=0

# Scheduler
CONFIG_SCHED_SMT=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_HRTICK=y
CONFIG_HIGH_RES_TIMERS=y

# Huge pages only where programs ask for them
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_DEFAULT_MMAP_MIN_ADDR=65536

# CPU+GPU kernel release name
CONFIG_LOCALVERSION="-5700v6650"
